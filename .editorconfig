# biome.json is the formatter of record; these values mirror it so editors stop
# fighting `bun run fmt`. Change biome.json first, then match it here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
tab_width = 3
max_line_length = 120

# biome.json: "json": { "indentStyle": "space", "indentWidth": 2 }
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# nixfmt and YAML have no tab dialect.
[*.nix]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Trailing double-space is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
